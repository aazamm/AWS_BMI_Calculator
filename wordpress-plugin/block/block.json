{
    "apiVersion": 3,
    "name": "bmi-calculator/bmi-block",
    "title": "BMI Calculator",
    "category": "widgets",
    "icon": "heart",
    "description": "BMI, BMR, TDEE and Macros calculator with history tracking.",
    "supports": {
        "html": false,
        "multiple": false
    },
    "attributes": {
        "primaryColor": {
            "type": "string",
            "default": "#0073aa"
        },
        "showHistory": {
            "type": "boolean",
            "default": true
        },
        "showConverter": {
            "type": "boolean",
            "default": true
        },
        "macroProtein": {
            "type": "number",
            "default": 30
        },
        "macroCarbs": {
            "type": "number",
            "default": 40
        },
        "macroFats": {
            "type": "number",
            "default": 30
        },
        "dietType": {
            "type": "string",
            "default": "balanced"
        }
    }
}
